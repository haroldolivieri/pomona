{
  "name": "pomona",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/hooks",
    "dev": "pnpm --filter @pomona/web dev",
    "dev:proxy": "pnpm --filter @pomona/proxy dev",
    "dev:all": "pnpm --parallel --filter @pomona/web --filter @pomona/proxy dev",
    "tunnel": "bash scripts/tunnel.sh",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
