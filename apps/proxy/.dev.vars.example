# Secrets for local Wrangler development (`wrangler dev`)
# Copy to `.dev.vars` and supply real keys for testing against live AI APIs

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
COOKIE_SIGNING_SECRET=generate_a_random_32_byte_secret_here_for_hmac

# Optional AI Gateway routing; leave both unset for direct local provider calls.
# Set these production Worker vars after creating or selecting the gateway.
# AI_GATEWAY_ACCOUNT_ID=your_cloudflare_account_id
# AI_GATEWAY_ID=your_gateway_id
# Secret required only when authenticated gateway access is enabled.
# AI_GATEWAY_TOKEN=your_ai_gateway_run_token
