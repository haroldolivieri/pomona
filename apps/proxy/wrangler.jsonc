{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pomona-proxy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "POMONA_QUOTA_KV",
      "id": "9b4f7acc62bb445c8d0ed30683ec4a2f",
      "preview_id": "60d7d61a6c244f13bce5676209ccac74"
    }
  ],
  "r2_buckets": [
    {
      "binding": "POMONA_CAPTURES_BUCKET",
      "bucket_name": "pomona-captures",
      "preview_bucket_name": "pomona-captures-preview"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },
  "vars": {
    "VISION_GATE_ENABLED": "true",
    "DEEP_SCAN_STORAGE_ENABLED": "true",
    "SCAN_STORAGE_ENABLED": "true",
    "AI_GATEWAY_ACCOUNT_ID": "553fb87d04f36b2f088f1250f34503cc",
    "AI_GATEWAY_ID": "pomona",
    "ACTIVE_PROMPT_VERSION": "v1",
    "ACTIVE_PROVIDER": "gemini",
    "DEFAULT_MODEL": "gemini-3.1-flash-lite"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
